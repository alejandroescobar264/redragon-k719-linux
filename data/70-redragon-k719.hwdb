# Redragon K719 (Evision): after any configuration command the firmware reports every
# key press/release to the vendor software as Consumer usages 0x05xx/0x06xx
# (xx = matrix slot). Linux maps these to KEY_UNKNOWN and, because the firmware never
# sends an empty report, the key stays "held" and auto-repeats, which floods the
# desktop with key events and makes typing lag. Mark them as reserved so they are dropped.
# Install: sudo cp 70-redragon-k719.hwdb /etc/udev/hwdb.d/ && sudo systemd-hwdb update
#          && sudo udevadm trigger --subsystem-match=input --action=change
evdev:input:b0003v320Fp511B*
evdev:input:b0003v320Fp511C*
 KEYBOARD_KEY_c0500=reserved
 KEYBOARD_KEY_c0501=reserved
 KEYBOARD_KEY_c0502=reserved
 KEYBOARD_KEY_c0503=reserved
 KEYBOARD_KEY_c0504=reserved
 KEYBOARD_KEY_c0505=reserved
 KEYBOARD_KEY_c0506=reserved
 KEYBOARD_KEY_c0507=reserved
 KEYBOARD_KEY_c0508=reserved
 KEYBOARD_KEY_c0509=reserved
